# PostgreSQL. docker compose maps this to localhost:5432.
DATABASE_URL=postgresql://flowproof:flowproof@127.0.0.1:5432/flowproof?schema=public&pgbouncer=true&connection_limit=5

# Local demo authentication. Hosted auth is not configured in this build.
# When FLOWPROOF_DEMO_MODE is false, production automation routes stay closed.
FLOWPROOF_DEMO_MODE=true
FLOWPROOF_SESSION_SECRET=replace-with-a-long-random-string

# Northstar Vendor Portal. The worker may navigate only to this origin unless
# FLOWPROOF_ALLOWED_ORIGINS adds another explicit origin.
DEMO_PORTAL_ORIGIN=http://127.0.0.1:4100
PORTAL_HOST=127.0.0.1
PORTAL_PORT=4100
PORTAL_ADMIN_TOKEN=replace-portal-admin-token
PORTAL_VERIFY_TOKEN=replace-portal-verify-token

# Optional comma-separated extra allowlist. Private and link-local addresses
# are still rejected unless the exact origin is listed here. Metadata IPs are
# always rejected.
FLOWPROOF_ALLOWED_ORIGINS=

WEB_ORIGIN=http://127.0.0.1:3000
ARTIFACT_DIR=./data/artifacts

WORKER_ID=worker-local
WORKER_CONCURRENCY=1
WORKER_POLL_MS=400

# Mozilla Otari. Leave the key empty for offline demo mode.
# OpenAI-compatible base URL includes /api/v1.
OTARI_API_KEY=
OTARI_BASE_URL=https://api.otari.ai/api/v1
OTARI_MODEL_PRIMARY=
OTARI_MODEL_REPAIR=
OTARI_MODEL_REVIEW=
# Application ceiling for recorded Otari spend on a single run.
OTARI_MAX_REQUEST_COST_USD=0.50
OTARI_REQUEST_TIMEOUT_MS=30000
# Public https origin Otari uses to call this app's read-only invoice MCP tool.
FLOWPROOF_PUBLIC_ORIGIN=

# Set to 1 inside containers that cannot use the Chromium sandbox.
PLAYWRIGHT_NO_SANDBOX=
