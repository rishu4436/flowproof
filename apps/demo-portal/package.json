{
  "name": "@flowproof/demo-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/server.ts",
    "start": "dotenv -e ../../.env -- tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "reset": "dotenv -e ../../.env -- tsx src/reset.ts"
  },
  "dependencies": {
    "@flowproof/core": "workspace:*",
    "@flowproof/database": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "dotenv-cli": "^10.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  }
}
